# Agency toolkit settings. install.sh copies this file to /etc/agency-toolkit/agency-toolkit.env
# (mode 640, root:agency-toolkit) only if that file does not exist yet.
#
# One KEY=value per line. Values are literal: no quotes. Lines starting with # are comments.
# Each feature stays off until its settings are filled in; the service logs which ones are on
# (journalctl -u agency-toolkit). Restart the service after editing: systemctl restart agency-toolkit

# --- General ---------------------------------------------------------------------------------

# Language of the alerts, the report and the invoices: en or es.
LANGUAGE=en
# Time zone of the weekly report schedule and its dates, for example Europe/Madrid.
# Empty: the server's time zone.
TIMEZONE=

# --- Telegram: uptime alerts, and a message when a scheduled job starts failing -------------

# Bot token from @BotFather, like 123456:REPLACE_ME.
TELEGRAM_BOT_TOKEN=
# Numeric chat ID that receives the alerts (YOUR_CHAT_ID). Ask @userinfobot for yours.
TELEGRAM_CHAT_ID=

# --- Client uptime monitor (needs Telegram) --------------------------------------------------

# Sites to watch, comma-separated, each one as Label|URL. For example:
#   UPTIME_SITES=Client A|https://example.com, Client B|https://shop.example.org, Client C|https://example.net/health
# No response or HTTP 500+ is "down", HTTP 400+ is a "warning". You get one alert when a site
# goes down, turns into a warning or recovers, not one every check.
UPTIME_SITES=
# Minutes between checks.
UPTIME_INTERVAL_MINUTES=5
# Seconds to wait for a site before counting it as down.
UPTIME_TIMEOUT_SECONDS=10

# --- Weekly analytics report (needs SMTP) ----------------------------------------------------

# Who receives it, comma-separated. For example: client@example.com
REPORT_TO=
# Name in the subject and the heading. Empty: the Plausible site ID (or the Umami website ID).
REPORT_SITE_NAME=
# Day (monday ... sunday) and local time (HH:MM) to send it.
REPORT_DAY=monday
REPORT_TIME=09:00
# Full days it covers, ending yesterday. 7 on a Monday = last Monday to Sunday.
REPORT_DAYS=7
# Where the numbers come from: plausible or umami.
ANALYTICS_PROVIDER=plausible

# Plausible. Keep https://plausible.io for Plausible Cloud, or put your self-hosted URL.
PLAUSIBLE_URL=https://plausible.io
# The site's domain as it appears in Plausible. For example: example.com
PLAUSIBLE_SITE_ID=
# In Plausible: your account settings > API keys > New API key (type Stats API).
PLAUSIBLE_API_KEY=

# Umami (only with ANALYTICS_PROVIDER=umami). The API root URL:
#   Umami Cloud: https://api.umami.is/v1
#   Self-hosted: https://umami.example.com/api
UMAMI_API_URL=
# Website ID (a UUID): Settings > Websites > Edit.
UMAMI_WEBSITE_ID=
# An API key (Umami Cloud, and recent self-hosted versions)...
UMAMI_API_KEY=
# ...or, for a self-hosted Umami without API keys, a username and password (no two-factor).
UMAMI_USERNAME=
UMAMI_PASSWORD=

# --- Invoices: python3 /opt/agency-toolkit/app/invoice.py invoice.json (needs SMTP) ---------

# Your Gotenberg (PDF rendering). For example: http://127.0.0.1:3000
GOTENBERG_URL=

# --- SMTP: used by the weekly report and the invoices ---------------------------------------

# For example: smtp.example.com
SMTP_HOST=
# starttls (port 587), ssl (port 465) or none (a local relay without encryption, port 25).
SMTP_SECURITY=starttls
# Empty: the usual port for SMTP_SECURITY.
SMTP_PORT=
# Leave the user empty for a relay without login.
SMTP_USER=
SMTP_PASSWORD=
# Sender of the emails. For example: Your Company <billing@example.com>
SMTP_FROM=
