# Contact form (email) → Telegram · settings and secrets.
# Installed as /etc/form-to-telegram/form-to-telegram.env (mode 640, root:form-to-telegram).
# One KEY=value per line, no quotes. After changing it: systemctl restart form-to-telegram

# Language of the messages: en or es.
LANGUAGE=en

# Your Telegram user ID (ask @userinfobot) and the bot that sends the alerts (@BotFather).
# The bot only sends, so you can reuse any bot you already have.
TELEGRAM_CHAT_ID=YOUR_CHAT_ID
BOT_TOKEN=REPLACE_ME

# Mailbox where your website sends the form emails.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=contact@example.com
IMAP_PASSWORD=REPLACE_ME
IMAP_FOLDER=INBOX

# Only unread emails whose subject contains this text are forwarded (plain ASCII works best).
SUBJECT_KEYWORD=New contact

# Optional: shown in the title ("New contact from example.com").
SITE_NAME=

# Optional: the labels your form email uses, comma-separated, in the order you want them.
# "Name: Ana" or "Name:" with "Ana" on the next line both work. Empty = subject and body as they are.
FIELDS=Name,Email,Phone
# Optional: the line where the free-text message starts, and the line where it ends.
MESSAGE_START=Message
MESSAGE_END=

CHECK_EVERY_SECONDS=60
# Failed checks in a row before saying on Telegram that the mailbox can't be read.
FAILURES_BEFORE_ALERT=5
