# Telegram personal assistant: /etc/personal-assistant/personal-assistant.env
# One KEY=value per line, no quotes. A feature turns itself off while one of its settings is empty;
# the journal says at startup which features are on and what each one that is off is missing.

# --- Telegram (required) -------------------------------------------------------------------------
# Token of a bot used only by this assistant, from @BotFather.
TELEGRAM_BOT_TOKEN=REPLACE_ME
# Your chat ID: the bot only answers this chat and sends the digests here.
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# --- General ---------------------------------------------------------------------------------------
# Language of the messages and of the AI summaries: en or es. Default: en.
LANGUAGE=en
# Time zone of the digest times and of the dates written to the sheets, like Europe/Madrid.
# Empty: the server's local time.
TIMEZONE=

# --- Gemini (email digest, news digest, read-it-later) ---------------------------------------------
# API key from Google AI Studio (https://aistudio.google.com/). Empty: those three features are off.
GEMINI_API_KEY=
# Model. Empty: gemini-flash-latest.
GEMINI_MODEL=

# --- Google account (email digest, calendar agenda, expense logger, read-it-later) -----------------
# OAuth client of type "Desktop app" and the refresh token printed by app/google_auth.py (see the README).
# Empty: those four features are off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Email digest (Gmail + Gemini) -----------------------------------------------------------------
# Time to send it, HH:MM. Empty: off.
EMAIL_DIGEST_TIME=08:00
# Gmail search of the messages to summarize. Default: the last day, without promotions or social.
EMAIL_QUERY=newer_than:1d -category:promotions -category:social
# Most messages to read. Default: 25.
EMAIL_MAX_MESSAGES=25

# --- Calendar agenda (Google Calendar) -------------------------------------------------------------
# Time to send today's agenda, HH:MM. Empty: off.
CALENDAR_DIGEST_TIME=07:30
# Calendar to read: primary (your main calendar) or the ID shown in the calendar's settings.
CALENDAR_ID=primary
# Working hours used to list your free slots (30 minutes or more). Defaults: 09:00 and 19:00.
CALENDAR_WORK_START=09:00
CALENDAR_WORK_END=19:00

# --- News digest (RSS/Atom + Gemini) ---------------------------------------------------------------
# Time to send it, HH:MM. Empty: off.
NEWS_DIGEST_TIME=08:00
# Feeds to read, comma-separated, like https://example.com/feed.xml,https://example.org/rss
# Empty: off.
RSS_FEEDS=

# --- Google Sheets (expense logger and read-it-later) ----------------------------------------------
# ID of the spreadsheet: the long part of its URL, docs.google.com/spreadsheets/d/<ID>/edit
# Empty: both features are off.
SPREADSHEET_ID=
# Tab for the expenses, columns Date, Amount, Currency, Category, Note. Empty: expense logger off.
EXPENSES_SHEET=Expenses
# Currency when a message names none (12 lunch). Default: €.
EXPENSE_CURRENCY=€
# Tab for the saved links, columns Date, Title, URL, Summary. Empty: read-it-later off.
READING_SHEET=Reading list
