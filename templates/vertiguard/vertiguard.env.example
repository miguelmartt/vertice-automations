# VertiGuard · settings and secrets of the service.
# Installed as /etc/vertiguard/vertiguard.env (mode 640, root:vertiguard). One KEY=value per line,
# no quotes. After changing it: systemctl restart vertiguard

# Language of every message and of the bot's commands: en or es.
LANGUAGE=en
# Time zone for the daily report and the times shown.
TIMEZONE=Europe/Madrid
# Name shown in the messages. Empty = the server's hostname.
SERVER_NAME=

# Your Telegram user ID (ask @userinfobot). Everything goes there, and the bot only answers you, in
# your private chat with it.
TELEGRAM_CHAT_ID=YOUR_CHAT_ID
# The bot (create it with @BotFather): alerts, daily report, commands and buttons.
BOT_TOKEN=REPLACE_ME
# off = the bot only sends alerts and the report, with no commands or buttons.
COMMANDS=on

# Google AI Studio key, to ask the bot in plain words. Empty = commands and buttons only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# UptimeRobot webhook: port on 127.0.0.1, path and shared secret. Empty port = off.
# UptimeRobot must send the secret as "token" in its JSON body (see the README); without it, a
# request gets a 404. The webhook stays off while WEBHOOK_TOKEN is empty or shorter than 16
# characters. Make one with: openssl rand -hex 32
WEBHOOK_PORT=
WEBHOOK_PATH=/webhook/uptimerobot
WEBHOOK_TOKEN=

# Daily report hour (0-23), or off. Backups are checked at BACKUP_CHECK_HOUR.
REPORT_HOUR=9
BACKUP_CHECK_HOUR=6
# Thresholds.
RESOURCE_ALERT_PCT=80
SSL_ALERT_DAYS=15
