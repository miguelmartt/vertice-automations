# VertiGuard · settings and secrets of the service.
# Installed as /etc/vertiguard/vertiguard.env (mode 640, root:vertiguard). One KEY=value per line,
# no quotes. After changing it: systemctl restart vertiguard

# Language of every message: en or es.
LANGUAGE=en
# Time zone for the daily and weekly reports.
TIMEZONE=Europe/Madrid

# Your Telegram user ID (ask @userinfobot). Alerts go there, and the DevOps bot only answers this chat.
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# Bot that sends the alerts (create it with @BotFather).
ALERTS_BOT_TOKEN=REPLACE_ME

# Bot for /menu and questions to Gemini. Empty = no DevOps bot. It may be the same bot as above.
DEVOPS_BOT_TOKEN=
# Google AI Studio key. Empty = the DevOps bot only offers /menu.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# UptimeRobot webhook: port on 127.0.0.1 and path. Empty port = off.
WEBHOOK_PORT=
WEBHOOK_PATH=/webhook/uptimerobot

# Thresholds and times.
RESOURCE_ALERT_PCT=80
SSL_ALERT_DAYS=15
REPORT_HOUR=9
BACKUP_CHECK_HOUR=6
